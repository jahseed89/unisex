# Edge Function environment variables
#
# These are SERVER secrets. Never prefix them with VITE_ and never commit real
# values. Set them with:
#   supabase secrets set --env-file supabase/functions/.env.local KEY=value
# or per function:
#   supabase functions deploy paystack-webhook --env-file ...
#
# Copy this file to `.env.local` and fill in. `.env.local` is gitignored.

# ---------------------------------------------------------------------------
# Provided automatically by Supabase in deployed environments. Do not set these
# locally unless running `supabase functions serve`.
# ---------------------------------------------------------------------------
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# CORS
# Comma-separated allowlist. Empty means "only SITE_URL".
# ---------------------------------------------------------------------------
SITE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Paystack — https://dashboard.paystack.com/#/settings/developers
# SECRET_KEY is live/test; the public key lives in the browser (.env.local).
# WEBHOOK_SECRET is under Settings → API Keys → Webhooks.
# ---------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Bank transfer (the fallback payment method shown at checkout)
# ---------------------------------------------------------------------------
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=Unisex Hair Studio

# ---------------------------------------------------------------------------
# Email — Resend (https://resend.com). Any SMTP relay works with the same shape.
# Without this the dispatcher logs emails instead of sending them.
# ---------------------------------------------------------------------------
SMTP_RELAY_KEY=
EMAIL_FROM=Unisex Hair Studio <no-reply@unisexhairstudio.com>

# ---------------------------------------------------------------------------
# SMS — Termii (https://termii.com), a common choice for the Nigerian market.
# ---------------------------------------------------------------------------
TERMII_API_KEY=
TERMII_SENDER_ID=UnisexHair

# ---------------------------------------------------------------------------
# WhatsApp Business Cloud API — https://developers.facebook.com/docs/whatsapp
# Requires a verified business, a registered sender (phone_number_id) and a
# message template for anything sent outside the 24-hour customer service window.
# ---------------------------------------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
