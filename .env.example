# ---------------------------------------------------------------------------
# Black Chery Unisex Studio — environment configuration
# Copy to `.env.local` and fill in. NEVER commit real keys.
# ---------------------------------------------------------------------------

# App
VITE_APP_URL=https://blackcheryunisexstudio.com
VITE_APP_ENV=production

# Supabase (Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Set to `true` to run the entire UI against realistic local mock data with no
# Supabase connection. Useful for design review and offline demos.
VITE_USE_MOCKS=false

# ---------------------------------------------------------------------------
# Google sign-in
#
# Three places, and all three must agree or the button fails:
#   1. Google Cloud Console -> APIs & Services -> Credentials
#        - OAuth client ID of type "Web application"
#        - Authorised JavaScript origin:  the app URL, e.g. http://localhost:5173
#        - Authorised redirect URI:     <app-url>/auth/callback
#   2. Supabase Dashboard -> Authentication -> Providers -> Google
#        - Client ID and Client Secret from step 1
#        - "Skip Non-Supabase URL Confirmation" ON for local testing
#   3. Here: set to `true` so the UI offers the button at all.
#
# The redirect lands back on `/auth/confirm`, which exchanges the code and
# signs the user in (see AuthConfirmPage). No secret belongs in this file —
# the Google client secret goes only in the Supabase dashboard.
# ---------------------------------------------------------------------------
VITE_GOOGLE_AUTH_ENABLED=false

# ---------------------------------------------------------------------------
# Transactional email (Mailgun via Supabase SMTP)
#
# Supabase sends confirmation, password-reset and invite emails through SMTP.
# It cannot send on the free plan, so a Mailgun sending domain is wired in at
# Project Settings -> Auth -> SMTP:
#
#   SMTP host     smtp.mailgun.org
#   Port          587          (465 with SSL if your Mailgun region requires)
#   Username      postmaster@<your-mailgun-sending-domain>
#   Password      <Mailgun SMTP password>
#   Sender        Black Chery <no-reply@<your-mailgun-sending-domain>>
#
# The Mailgun API key is NOT needed here — SMTP uses the sending-domain
# password, and both it and any `MAILGUN_*` secret belong in Supabase, never in
# a VITE_* variable (VITE_ values are public in the browser bundle).
#
# On a local stack, `supabase/config.toml` carries the same values so
# `npm run supabase:start` sends real mail.
# ---------------------------------------------------------------------------

# Payments — Paystack (primary, Nigeria)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_PAYSTACK_ENABLED=true

# WhatsApp Business Cloud API (server-only secret must live in Supabase Edge
# Function env, never in VITE_* — VITE_ vars are public in the bundle)
VITE_WHATSAPP_ENABLED=false
VITE_WHATSAPP_PHONE_NUMBER=2348000000000

# Analytics
VITE_GA_MEASUREMENT_ID=
VITE_PLAUSIBLE_DOMAIN=
VITE_ENABLE_ANALYTICS=false

# Support
VITE_SUPPORT_EMAIL=hello@blackcheryunisexstudio.com
VITE_SUPPORT_PHONE=+2348000000000