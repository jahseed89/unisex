# ---------------------------------------------------------------------------
# Unisex Hair Studio — environment configuration
# Copy to `.env.local` and fill in. NEVER commit real keys.
# ---------------------------------------------------------------------------

# App
VITE_APP_URL=https://unisexhairstudio.com
VITE_APP_ENV=production

# Supabase (Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Set to `true` to run the entire UI against realistic local mock data with no
# Supabase connection. Useful for design review and offline demos.
VITE_USE_MOCKS=false

# Payments — Paystack (primary, Nigeria)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_PAYSTACK_ENABLED=true

# WhatsApp Business Cloud API (server-only secret must live in Supabase Edge
# Function env, never in VITE_* — VITE_ vars are public in the bundle)
VITE_WHATSAPP_ENABLED=false
VITE_WHATSAPP_PHONE_NUMBER=2348000000000

# Analytics
VITE_GA_MEASUREMENT_ID=
VITE_PLAUSIBLE_DOMAIN=
VITE_ENABLE_ANALYTICS=false

# Support
VITE_SUPPORT_EMAIL=hello@unisexhairstudio.com
VITE_SUPPORT_PHONE=+2348000000000